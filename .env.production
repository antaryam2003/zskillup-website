# Public build configuration for the GitHub Pages deployment.
# Nothing secret lives here - these are all NEXT_PUBLIC_ values baked into the
# client bundle, which is why this file is committed.

# Served from https://antaryam2003.github.io/zskillup-website/
NEXT_PUBLIC_SITE_URL=https://antaryam2003.github.io/zskillup-website
NEXT_PUBLIC_BASE_PATH=/zskillup-website

# GitHub Pages serves files only, so there is no /api/enquiry to POST to.
# This switches the enquiry form to composing a pre-filled email instead.
NEXT_PUBLIC_STATIC_EXPORT=true
